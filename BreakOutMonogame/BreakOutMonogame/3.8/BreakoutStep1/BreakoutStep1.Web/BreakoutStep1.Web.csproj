<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BreakoutStep1.Web</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);BLAZORGL</DefineConstants>
    <KniPlatform>BlazorGL</KniPlatform>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content.Pipeline.Builder" Version="4.3.9001" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile the actual game against KNI instead of the Windows-only framework. -->
    <Compile Include="../BreakoutStep1/*.cs" Exclude="../BreakoutStep1/Program.cs" Link="Game/%(Filename)%(Extension)" />
    <Compile Include="../MonoGameLibrary/Sprite/Sprite.cs" Link="Library/Sprite.cs" />
    <Compile Include="../MonoGameLibrary/Sprite/DrawableSprite.cs" Link="Library/DrawableSprite.cs" />
    <Compile Include="../MonoGameLibrary/Util/InputHandler.cs" Link="Library/InputHandler.cs" />
    <KniContentReference Include="Content/Content.mgcb" />
  </ItemGroup>
</Project>
